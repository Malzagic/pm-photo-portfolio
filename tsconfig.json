{
  "compilerOptions": {
    /* Required for TS 6.0+ to silence baseUrl deprecation warnings */
    "ignoreDeprecations": "6.0",

    /* CRITICAL FIX: Use "preserve" to keep .jsx extensions in output.
      This ensures your build process (like Vite or others) sees the files as expected.
    */
    "jsx": "preserve",

    /* Base directory for path resolution */
    "baseUrl": ".",

    /* Path mapping for professional alias imports (@/...) */
    "paths": {
      "@/*": ["src/*"]
    },

    /* Modern production standards */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
